# InEra All-in-One Plugins — configuration
# Copy this file to ".env" (same folder) and edit. Every line is optional.

# ---------------------------------------------------------------- server
INERA_HOST=0.0.0.0
INERA_PORT=8000
# Where the database, uploads and generated files live (outside the code folder).
# INERA_DATA_DIR=/var/lib/inera
# Your public HTTPS address. REQUIRED for Instagram publishing (Instagram downloads the image from here).
# PUBLIC_BASE_URL=https://plugins.yourdomain.com
# Set true when running behind Nginx/Caddy/Cloudflare so client IPs and HTTPS are detected correctly.
TRUST_PROXY=false
# IP address(es) of that reverse proxy; only these may set X-Forwarded-For.
FORWARDED_ALLOW_IPS=127.0.0.1
# Secure cookies are switched on automatically when PUBLIC_BASE_URL starts with https://
# COOKIE_SECURE=true
# Long random string. If empty, one is generated and stored in the data folder (back it up: it encrypts saved connections).
# SECRET_KEY=
ALLOW_REGISTRATION=true
# Comma-separated e-mails that become admins (the first account is always admin).
# ADMIN_EMAILS=you@yourdomain.com
CONTACT_EMAIL=admin@example.com

# ---------------------------------------------------------------- limits (public deployments)
MAX_UPLOAD_MB=50
MAX_FILES_PER_RUN=20
WORKERS=2
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_RUNS_PER_DAY=200
MAX_AUTOMATIONS_PER_USER=25
MIN_INTERVAL_MINUTES=15
# Generated files and run history older than this are deleted automatically (0 = keep forever).
RETENTION_DAYS=30
# Keep false on public servers (blocks requests to private/internal networks).
ALLOW_PRIVATE_NETWORK=false

# ---------------------------------------------------------------- AI engine (optional but recommended)
# auto = Anthropic key > OpenAI key > local Ollama > built-in offline engine
LLM_PROVIDER=auto
# Fully self-hosted and free: install Ollama (https://ollama.com), then `ollama pull llama3.1`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Any OpenAI-compatible endpoint (OpenAI, Groq, Together, LM Studio, vLLM ...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT=180

# ---------------------------------------------------------------- research & media
WEB_RESEARCH=true
WIKI_LANG=en
# Better voices: install Piper (https://github.com/rhasspy/piper) and point to a voice model (.onnx)
# PIPER_MODEL=/opt/piper/en_US-lessac-medium.onnx
TTS_VOICE=en-us
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
# Tesseract languages installed on the server, e.g. eng+hin+kan
OCR_LANGS=eng

# ---------------------------------------------------------------- Instagram Graph API
IG_GRAPH_HOST=graph.instagram.com
IG_GRAPH_VERSION=v25.0
